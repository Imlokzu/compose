# SERVER ONLY. Never pass this secret to the desktop build or commit a real value.
COMPOSE_BGCLEAR_API_KEY=replace-in-your-host-secret-settings
COMPOSE_SERVICE_BIND=0.0.0.0:8787
COMPOSE_MAX_CONCURRENT=2
COMPOSE_PER_IP_MINUTE=3
COMPOSE_PER_IP_DAY=30
COMPOSE_GLOBAL_DAY=500
# Optional mounted secret: COMPOSE_BGCLEAR_API_KEY_FILE=/run/secrets/bgclear
# Trust only the immediate reverse proxy/tunnel IPs that you control.
COMPOSE_TRUSTED_PROXY_IPS=
